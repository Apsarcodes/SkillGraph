# SkillGraph AI Environment Configuration Template
ENVIRONMENT=development
APP_NAME=SkillGraph AI
DEBUG=true
PORT=8000
FRONTEND_PORT=5173

# Database (Default: local SQLite; Supports PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./skillgraph.db
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Security & Authentication
SECRET_KEY=skillgraph-local-development-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & RAG Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
AI_FALLBACK_MODE=true

# Privacy
ENABLE_PII_REDACTION=true
LOG_RAW_RESUMES=false
